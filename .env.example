# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://obot:obot@localhost:5432/obot"

# ── Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public URL people use to reach Obot (used for auth callbacks and invite links)
APP_URL="http://localhost:3000"
# Optional: other origins allowed to sign in (comma-separated), e.g. a Tailscale name
TRUSTED_ORIGINS=""
# Optional (dev only): extra hostnames allowed to load dev assets, e.g. "day-mac,*.ts.net"
ALLOWED_DEV_ORIGINS=""

# ── CLIProxyAPI ───────────────────────────────────────────
# Base URL of your CLIProxyAPI server (with or without a trailing /v1)
CLIPROXY_BASE_URL="http://localhost:8317"
# One of the client keys from CLIProxyAPI's `access.api-keys` list
CLIPROXY_API_KEY=""

# ── Storage ───────────────────────────────────────────────
# Where uploaded images are written on local disk
UPLOAD_DIR="./data/uploads"
