// Obot database schema.
// Money is stored as integer micro-dollars (1 USD = 1_000_000) in BigInt columns.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum LimitMode {
  INHERIT
  CUSTOM
  UNLIMITED
}

enum DefaultLimitMode {
  LIMITED
  UNLIMITED
}

enum UnpricedModelPolicy {
  BLOCK_LIMITED
  FREE
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageStatus {
  STREAMING
  COMPLETE
  STOPPED
  ERROR
}

enum RunStatus {
  RUNNING
  COMPLETED
  STOPPED
  FAILED
  INTERRUPTED
}

enum UsageKind {
  CHAT
  TITLE
  SUBAGENT
}

enum ArtifactKind {
  MARKDOWN
  HTML
  REACT
}

enum ArtifactStatus {
  GENERATING
  READY
  FAILED
}

enum ThreadKind {
  CHAT
  SUBAGENT
}

enum SubagentTaskStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  INTERRUPTED
}

// ───────────────────── Auth (Better Auth core tables) ─────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Obot fields
  role               Role       @default(USER)
  status             UserStatus @default(ACTIVE)
  limitMode          LimitMode  @default(INHERIT)
  weeklyLimitMicros  BigInt?
  monthlyLimitMicros BigInt?
  webSearchDefault   Boolean?
  defaultModelId     String?
  defaultEffort      String?

  sessions       Session[]
  accounts       Account[]
  threads        Thread[]
  attachments    Attachment[]
  runs           Run[]
  usageRecords   UsageRecord[]
  artifacts      Artifact[]
  invitesCreated Invite[]      @relation("InviteCreatedBy")
  invitesUsed    Invite[]      @relation("InviteUsedBy")
  pricesCreated  ModelPrice[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ───────────────────────────── Admin ─────────────────────────────

model Invite {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  email       String?
  role        Role      @default(USER)
  note        String?
  createdById String
  createdBy   User      @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
  usedBy      User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@map("invite")
}

/// Single-row instance settings (id is always "global").
model AppSettings {
  id                        String              @id @default("global")
  defaultLimitMode          DefaultLimitMode    @default(UNLIMITED)
  defaultWeeklyLimitMicros  BigInt?
  defaultMonthlyLimitMicros BigInt?
  unpricedModelPolicy       UnpricedModelPolicy @default(BLOCK_LIMITED)
  webSearchDefault          Boolean             @default(true)
  webSearchContextSize      String              @default("medium")
  webSearchAllowedDomains   String[]            @default([])
  titleModelId              String?
  titleEffort               String?
  systemPrompt              String?
  modelsSyncedAt            DateTime?
  agentMaxSteps             Int                 @default(50)
  sandboxEnabled            Boolean             @default(true)
  sandboxPythonEnabled      Boolean             @default(true)
  artifactsEnabled          Boolean             @default(true)
  inlineUiEnabled           Boolean             @default(true)
  subagentsEnabled          Boolean             @default(false)
  subagentMaxConcurrent     Int                 @default(4)
  subagentMaxSteps          Int                 @default(30)
  updatedAt                 DateTime            @updatedAt

  @@map("app_settings")
}

model Model {
  id                    String       @id
  ownedBy               String?
  enabled               Boolean      @default(false)
  available             Boolean      @default(true)
  displayNameOverride   String?
  contextWindowOverride Int?
  sortOrder             Int          @default(0)
  lastSeenAt            DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  prices                ModelPrice[]
  subagentModel         SubagentModel?

  @@map("model")
}

/// Append-only price history. A price is active from `effectiveFrom` until a newer row supersedes it.
model ModelPrice {
  id                    String        @id @default(cuid())
  modelId               String
  model                 Model         @relation(fields: [modelId], references: [id], onDelete: Restrict)
  effectiveFrom         DateTime      @default(now())
  inputPerMMicros       BigInt
  cachedInputPerMMicros BigInt
  cacheWritePerMMicros  BigInt?
  outputPerMMicros      BigInt
  webSearchPer1kMicros  BigInt        @default(0)
  longContextThreshold  Int?
  longContextInputMult  Float?
  longContextOutputMult Float?
  createdById           String?
  createdBy             User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt             DateTime      @default(now())
  usageRecords          UsageRecord[]

  @@index([modelId, effectiveFrom])
  @@map("model_price")
}

// ───────────────────────────── Threads ─────────────────────────────

model Thread {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  title            String        @default("New thread")
  titleGenerated   Boolean       @default(false)
  pinned           Boolean       @default(false)
  webSearchEnabled Boolean?
  lastModelId      String?
  lastEffort       String?
  lastContext      Json?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  lastMessageAt    DateTime      @default(now())
  kind             ThreadKind    @default(CHAT)
  parentThreadId   String?
  parentThread     Thread?       @relation("ThreadChildren", fields: [parentThreadId], references: [id], onDelete: Cascade)
  children         Thread[]      @relation("ThreadChildren")
  messages         Message[]
  runs             Run[]
  spawnedTasks     SubagentTask[] @relation("TaskParent")
  task             SubagentTask?  @relation("TaskChild")
  artifacts        Artifact[]

  @@index([userId, deletedAt, lastMessageAt])
  @@index([parentThreadId])
  @@map("thread")
}

model Message {
  id           String        @id @default(cuid())
  threadId     String
  thread       Thread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role         MessageRole
  parts        Json          @default("[]")
  rawOutput    Json?
  modelId      String?
  effort       String?
  webSearch    Boolean       @default(false)
  status       MessageStatus @default(COMPLETE)
  error        String?
  responseId   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  attachments  Attachment[]
  runs         Run[]
  spawnedTasks SubagentTask[]

  @@index([threadId, createdAt])
  @@map("message")
}

model Attachment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  path      String
  fileName  String
  mime      String
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([userId])
  @@map("attachment")
}

model Run {
  id                 String    @id @default(cuid())
  threadId           String
  thread             Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  assistantMessageId String?
  assistantMessage   Message?  @relation(fields: [assistantMessageId], references: [id], onDelete: SetNull)
  status             RunStatus @default(RUNNING)
  error              String?
  kind               ThreadKind @default(CHAT)
  parentRunId        String?
  steps              Int       @default(0)
  startedAt          DateTime  @default(now())
  endedAt            DateTime?

  @@index([threadId, status])
  @@index([status])
  @@index([parentRunId])
  @@map("run")
}

// ───────────────────────────── Sub-agents ─────────────────────────────

/// Admin allowlist of models sub-agents may run on. Descriptions are shown to the orchestrating model.
model SubagentModel {
  modelId       String   @id
  model         Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  description   String?
  defaultEffort String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  @@map("subagent_model")
}

/// A delegated sub-agent task: one child thread driven by a parent run.
model SubagentTask {
  id              String             @id @default(cuid())
  userId          String
  parentThreadId  String
  parentThread    Thread             @relation("TaskParent", fields: [parentThreadId], references: [id], onDelete: Cascade)
  parentRunId     String
  parentMessageId String?
  parentMessage   Message?           @relation(fields: [parentMessageId], references: [id], onDelete: SetNull)
  callId          String
  childThreadId   String             @unique
  childThread     Thread             @relation("TaskChild", fields: [childThreadId], references: [id], onDelete: Cascade)
  childRunId      String?
  title           String
  prompt          String
  modelId         String
  effort          String?
  status          SubagentTaskStatus @default(RUNNING)
  result          String?
  error           String?
  notifiedAt      DateTime?
  createdAt       DateTime           @default(now())
  endedAt         DateTime?

  @@index([parentRunId, status])
  @@index([parentThreadId])
  @@index([status])
  @@map("subagent_task")
}

// ───────────────────────────── Usage ─────────────────────────────

/// Append-only, permanent usage ledger. A database trigger rejects UPDATE and DELETE.
/// Foreign keys use plain columns (no FK constraints on thread/message/run) so that
/// deleting threads or messages never needs to touch this table.
model UsageRecord {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  threadId          String?
  messageId         String?
  runId             String?
  kind              UsageKind   @default(CHAT)
  modelId           String
  effort            String?
  inputTokens       Int         @default(0)
  cachedInputTokens Int         @default(0)
  cacheWriteTokens  Int         @default(0)
  outputTokens      Int         @default(0)
  reasoningTokens   Int         @default(0)
  totalTokens       Int         @default(0)
  webSearchCalls    Int         @default(0)
  costMicros        BigInt      @default(0)
  priced            Boolean     @default(false)
  priceId           String?
  price             ModelPrice? @relation(fields: [priceId], references: [id], onDelete: Restrict)
  responseId        String?
  note              String?
  stepIndex         Int?
  rootThreadId      String?
  createdAt         DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([threadId])
  @@index([rootThreadId])
  @@index([createdAt])
  @@map("usage_record")
}

// ───────────────────────────── Artifacts ─────────────────────────────

/// A saved document/app the agent created on request. Every update adds a version.
model Artifact {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  threadId       String
  thread         Thread            @relation(fields: [threadId], references: [id], onDelete: Cascade)
  title          String
  kind           ArtifactKind
  status         ArtifactStatus    @default(READY)
  currentVersion Int               @default(0)
  runId          String?
  error          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  versions       ArtifactVersion[]

  @@index([userId, deletedAt, updatedAt])
  @@index([threadId])
  @@map("artifact")
}

model ArtifactVersion {
  id         String   @id @default(cuid())
  artifactId String
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  version    Int
  title      String
  content    String
  messageId  String?
  createdAt  DateTime @default(now())

  @@unique([artifactId, version])
  @@map("artifact_version")
}
